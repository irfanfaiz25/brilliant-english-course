# Copy to .env.local for local development. Never commit real values.

# --- Server ---
# Local Docker database from docker-compose.yml (host port 5433 avoids a local Postgres on 5432).
DATABASE_URL=postgres://bec:bec@localhost:5433/bec
DATABASE_POOL_MAX=10

# Signs session cookies and reset tokens (min 32 chars): openssl rand -base64 32
BETTER_AUTH_SECRET=

# Internal /design-system preview (defaults to on outside production; set true on staging).
ENABLE_DESIGN_PREVIEW=true

# Cloudflare R2 for uploaded media: set all four or none. Without them uploads are stored in the
# git-ignored .storage/ folder and served from /api/media/files (local development and CI).
# Token: R2 "Object Read & Write", limited to the bucket. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Public (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public URL of the R2 bucket (custom domain, e.g. https://media.example.com). Required with R2.
NEXT_PUBLIC_MEDIA_URL=
